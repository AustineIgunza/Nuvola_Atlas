VITE_MAPBOX_TOKEN=
VITE_MAPBOX_STYLE=mapbox://styles/mapbox/dark-v11

# Base URL for the Laravel API. Same-origin default works when the frontend
# is served behind a Vercel rewrite to the backend host.
VITE_API_BASE=/api/v1

# Master switch: leave unset (or false) for mock data; set to "true" only on
# Vercel Production. Preview deployments stay on mock so partners can review
# UI without depending on the backend being up.
VITE_USE_REMOTE_API=false

# Sentry (9.11). Leave VITE_SENTRY_DSN unset to disable client-side reporting
# entirely — the SDK never initialises. Set on Vercel Production once a
# Sentry project exists.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Build-time only (Vercel Production env). Required for source-map upload to
# Sentry; if any are missing the Vite plugin is not registered, builds stay
# fast, and no auth call is made.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
