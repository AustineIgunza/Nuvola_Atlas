{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd nuvola-atlas-frontend && npm ci --no-audit --no-fund",
  "buildCommand": "cd nuvola-atlas-frontend && npm run build",
  "outputDirectory": "nuvola-atlas-frontend/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
