APP_NAME="Nuvola Atlas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=nuvola_atlas
DB_USERNAME=nuvola
DB_PASSWORD=nuvola_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=nuvola-atlas
REVERB_APP_KEY=nuvola-atlas-key
REVERB_APP_SECRET=nuvola-atlas-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

CORS_ALLOWED_ORIGINS=http://localhost:5173
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

SANCTUM_TOKEN_EXPIRATION=480

# RAG chatbot — Vercel AI Gateway. Leave AI_GATEWAY_API_KEY blank to disable
# the chat endpoint (returns 503 "AI is not configured" until it's set).
AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-4-6
AI_GATEWAY_TIMEOUT=45
AI_CHAT_RATE_LIMIT=10
AI_CHAT_CONTEXT=6

# Chat pipeline runs SQL through a read-only role that only has SELECT on the
# allowlisted tables (see 2026_07_09_000001_create_chat_readonly_role). These
# grants are the primary control on what LLM-authored SQL can reach.
#
# Required in every environment, local dev included. There is no fallback to
# DB_USERNAME: left blank — or set to the same user as DB_USERNAME — the chat
# endpoint returns 503 instead of running generated SQL with full privileges.
# Run `php artisan migrate` after setting these so the role gets provisioned.
DB_CHAT_RO_USER=nuvola_chat_ro
DB_CHAT_RO_PASSWORD=

# Assistant agent runtime. `heuristic` needs no key and ships tool routing
# without an external model. Set AGENT_PROVIDER=huggingface only once the HF
# Inference Endpoint is live — HF_ENDPOINT and HF_TOKEN are required then.
AGENT_PROVIDER=heuristic
HF_ENDPOINT=
HF_TOKEN=
HF_MODEL=
HF_TIMEOUT=60

# Hop 2 of the ingestion path (FastAPI → Laravel). NOTE the name asymmetry:
# the ingestion service reads the same value as INGESTION_INTERNAL_SECRET.
# They must be byte-identical or every batch 401s. Blank fails closed (503).
INGEST_INTERNAL_SECRET=

# Google OAuth. Redirect defaults to APP_URL + /api/v1/auth/google/callback;
# whatever it resolves to must be registered verbatim in the Google console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Sentry. Blank disables reporting entirely — the SDK never binds, so local
# dev and CI make no network calls.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.1

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_MAPBOX_TOKEN=
