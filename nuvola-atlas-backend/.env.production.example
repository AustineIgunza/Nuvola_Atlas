# ────────────────────────────────────────────────────────────────────────────
# Nuvola Atlas — production .env template (Laravel Forge + DigitalOcean)
#
# Paste this into Forge under "Application > Environment", then fill in every
# bracketed value. Anything left as <…> WILL break the deploy on first request.
#
# See docs/ops/deploy.md for the full walkthrough.
# ────────────────────────────────────────────────────────────────────────────

APP_NAME="Nuvola Atlas"
APP_ENV=production
APP_KEY=<run `php artisan key:generate --show` once locally and paste>
APP_DEBUG=false
APP_URL=https://<api-host, e.g. api.nuvola-atlas.example>

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

# JSON to stderr so BetterStack / Forge's papertrail agent can parse fields
# directly; daily file rotation kept as a local fallback. The `json` channel
# is defined in config/logging.php with Monolog's JsonFormatter.
LOG_CHANNEL=stack
LOG_STACK=json,daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ── Database ────────────────────────────────────────────────────────────────
# Recommended: Supabase managed Postgres + PostGIS. Use the *pooled* connection
# string (port 6543) for normal traffic; keep the direct string for migrations.
# Forge can also provision a local Postgres on the same droplet if you want to
# postpone the Supabase decision — in that case, enable the PostGIS extension
# manually (see docs/ops/deploy.md §3).
DB_CONNECTION=pgsql
DB_HOST=<aws-0-eu-central-1.pooler.supabase.com>
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=<postgres.project_ref>
DB_PASSWORD=<supabase-db-password>
DB_SSLMODE=require

# Used by `artisan migrate --force` only (direct, non-pooled).
DB_MIGRATIONS_HOST=<db.project-ref.supabase.co>
DB_MIGRATIONS_PORT=5432

# ── Cache / sessions / queue ────────────────────────────────────────────────
# Forge provisions Redis on the droplet via the "Redis" service add-on.
# Keep everything on Redis — file/database drivers will not survive the
# scale-out path documented in 9.10.
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=redis
CACHE_PREFIX=nuvola_

QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ── Broadcasting (Reverb) ───────────────────────────────────────────────────
# Reverb runs as a Forge Daemon (see docs/ops/deploy.md §6). nginx terminates
# TLS for /app and /apps/* and proxies the websocket to 127.0.0.1:8080.
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=<random-app-id>
REVERB_APP_KEY=<random-app-key-shared-with-frontend>
REVERB_APP_SECRET=<long-random-secret>
REVERB_HOST=<api-host>
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# ── Auth / API ──────────────────────────────────────────────────────────────
SANCTUM_TOKEN_EXPIRATION=480
SANCTUM_STATEFUL_DOMAINS=<frontend-host, e.g. atlas.nuvola-atlas.example>

# Comma-separated allow-list. Must exactly match the deployed Vercel origins
# (production + any custom domain). No trailing slashes.
CORS_ALLOWED_ORIGINS=https://<frontend-host>,https://nuvola-atlas.vercel.app

# Cloudflare sits in front of the droplet, so trust its proxy headers.
TRUSTED_PROXIES=*

# ── Mail ────────────────────────────────────────────────────────────────────
# Pick one provider and delete the others. Postmark is the cheapest for the
# pilot's expected volume (verification + password-reset only).
MAIL_MAILER=postmark
MAIL_FROM_ADDRESS=no-reply@<api-host>
MAIL_FROM_NAME="${APP_NAME}"
POSTMARK_TOKEN=<postmark-server-token>

# ── Object storage (reports, screen recordings) ─────────────────────────────
# Cloudflare R2 via the S3-compatible API. Cheapest egress for our use case.
FILESYSTEM_DISK=r2
AWS_ACCESS_KEY_ID=<r2-access-key>
AWS_SECRET_ACCESS_KEY=<r2-secret-key>
AWS_DEFAULT_REGION=auto
AWS_BUCKET=<r2-bucket-name>
AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── Frontend build-time vars (only used if Inertia rendering server-side) ──
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_MAPBOX_TOKEN=<mapbox-public-token>

# ── Observability (9.11) ────────────────────────────────────────────────────
# Unset DSN → sentry-laravel boots in no-op mode (zero overhead). Set it when
# the Sentry project exists. SENTRY_AUTH_TOKEN is build-time only and lives
# on Vercel, not here.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false
